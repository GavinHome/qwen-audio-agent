# 唯一必填项：Qwen Audio Realtime 与默认 OpenCode 模型共用此凭据。
DASHSCOPE_API_KEY=

# 可选：默认使用 opencode；也可以选择 openclaw、qoder 或通用 acp。
# AGENT_PROTOCOL=opencode

# 默认托管模式会自动启动带专用后台 Agent 的服务。
# 连接用户已经启动的 OpenCode / OpenClaw 时改为 compatible。
# Qoder 通过官方 SDK 管理 CLI 子进程，只支持 managed。
# QWEN_AUDIO_AGENT_BACKEND_MODE=managed
# QWEN_AUDIO_AGENT_BACKEND_PERMISSION_MODE=native
# QWEN_AUDIO_AGENT_BACKEND_AGENT=

# 可选：仅在复用非默认地址的后台服务时填写。
# OPENCODE_BASE_URL=http://127.0.0.1:4096
# OPENCLAW_BASE_URL=http://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=

# Qoder 默认复用 qodercli 的登录和原生 Session 存储。
# QODER_MODEL=auto
# QODERCLI_PATH=
# QODER_AUTH_MODE=cli

# 任意支持 ACP stdio 的 Agent 可通过通用入口接入；参数建议使用 JSON 数组。
# AGENT_PROTOCOL=acp
# ACP_COMMAND=your-agent
# ACP_ARGS=["--acp"]
# ACP_LABEL=Your Agent
# ACP_MODEL=auto
# ACP_WORKSPACE=

# 远程访问必须使用带认证的 HTTPS 反向代理，并显式填写其公开 Origin。
# QWEN_AUDIO_AGENT_ALLOWED_ORIGINS=https://voice.example.com
