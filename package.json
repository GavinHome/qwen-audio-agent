{
  "name": "qwen-audio-agent",
  "version": "0.2.0",
  "description": "A realtime voice frontend for OpenCode and OpenClaw.",
  "author": "qwen-audio-agent contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QwenLM/qwen-audio-agent.git"
  },
  "bugs": {
    "url": "https://github.com/QwenLM/qwen-audio-agent/issues"
  },
  "homepage": "https://github.com/QwenLM/qwen-audio-agent#readme",
  "keywords": [
    "qwen",
    "audio",
    "voice",
    "agent",
    "opencode",
    "openclaw"
  ],
  "type": "module",
  "bin": {
    "qwenaudio": "cli/bin/qwenaudio.mjs"
  },
  "files": [
    "cli/bin/",
    "cli/src/",
    "cli/package.json",
    "config/frontend-agent/",
    "config/openclaw.json5",
    "config/openclaw-workspace/AGENTS.md",
    "config/opencode/agents/",
    "config/opencode/plugin/",
    "config/opencode-workspace/AGENTS.md",
    "docs/configuration.md",
    "server/src/",
    "server/package.json",
    "shared/",
    "scripts/",
    "tui/fullscreen/app.py",
    "tui/native/",
    "tui/src/",
    "tui/package.json",
    "web/dist/",
    "LICENSE",
    "NOTICE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.4",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "workspaces": [
    "server",
    "web",
    "tui",
    "desktop",
    "cli"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev --workspace server\" \"npm run dev --workspace web\"",
    "build": "npm run build --workspace web",
    "prepack": "npm run build",
    "install:global": "node scripts/install-global.mjs",
    "start": "node scripts/start.mjs",
    "pregateway": "npm run build",
    "gateway": "npm run start --workspace server",
    "desktop": "npm run start --workspace desktop",
    "desktop:build": "node scripts/check-desktop-release-env.mjs && npm run build && electron-builder --config desktop/electron-builder.yml --mac dmg",
    "desktop:build:local": "npm run build && electron-builder --config desktop/electron-builder.yml --config.mac.identity=- --config.mac.hardenedRuntime=false --config.mac.notarize=false --mac dmg",
    "cli": "npm run start --workspace @qwen-audio-agent/cli --",
    "tui": "npm run start --workspace tui --",
    "backend": "./scripts/backend",
    "openclaw": "./scripts/openclaw-gateway",
    "opencode": "./scripts/opencode-server",
    "test": "npm run test --workspace server && npm run test --workspace web && npm run test --workspace tui && npm run test --workspace desktop && npm run test --workspace @qwen-audio-agent/cli",
    "release:check": "./scripts/release-check",
    "tui:full": "npm run fullscreen --workspace tui --",
    "tui:text": "npm run text --workspace tui --"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.5",
    "express": "^4.22.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "electron-builder": "26.15.7"
  },
  "overrides": {
    "@electron/asar": "4.2.1",
    "@electron/universal": "3.0.6"
  }
}
