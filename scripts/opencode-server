#!/bin/sh
set -eu

QWEN_AUDIO_AGENT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
OPENCODE_PORT=${OPENCODE_PORT:-4096}
OPENCODE_RUNTIME=${OPENCODE_RUNTIME:-auto}
OPENCODE_PACKAGE=${OPENCODE_PACKAGE:-opencode-ai@1.18.5}
OPENCODE_MIN_VERSION=${OPENCODE_MIN_VERSION:-1.18.0}
OPENCODE_COMMAND=${OPENCODE_COMMAND:-serve}
QWEN_AUDIO_AGENT_NODE=${QWEN_AUDIO_AGENT_NODE:-node}

if [ -z "${OPENCODE_MODEL:-}" ] && [ -n "${QWEN_AUDIO_AGENT_BACKEND_MODEL:-}" ]; then
  MODEL_ID=${QWEN_AUDIO_AGENT_BACKEND_MODEL#*/}
  export OPENCODE_MODEL="alibaba-cn/$MODEL_ID"
fi

if [ "${QWEN_AUDIO_AGENT_ENV_LOADED:-}" != "1" ]; then
  if [ -f "$QWEN_AUDIO_AGENT_ROOT/.env.local" ]; then
    set -a
    . "$QWEN_AUDIO_AGENT_ROOT/.env.local"
    set +a
  elif [ -f "$QWEN_AUDIO_AGENT_ROOT/.env" ]; then
    set -a
    . "$QWEN_AUDIO_AGENT_ROOT/.env"
    set +a
  fi
  export QWEN_AUDIO_AGENT_ENV_LOADED=1
fi

# Preserve the user's native OpenCode configuration. Isolation remains
# available as an explicit troubleshooting option for conflicting user config.
if [ -n "${QWEN_AUDIO_AGENT_OPENCODE_XDG_CONFIG_HOME:-}" ]; then
  export XDG_CONFIG_HOME="$QWEN_AUDIO_AGENT_OPENCODE_XDG_CONFIG_HOME"
elif [ "${QWEN_AUDIO_AGENT_OPENCODE_ISOLATE_USER_CONFIG:-false}" = "true" ]; then
  export XDG_CONFIG_HOME="$QWEN_AUDIO_AGENT_ROOT/runtime/opencode-xdg"
fi

run_binary() {
  if [ "$OPENCODE_COMMAND" = "serve" ]; then
    exec "$OPENCODE_BIN" serve --hostname 127.0.0.1 --port "$OPENCODE_PORT" "$@"
  fi
  exec "$OPENCODE_BIN" "$OPENCODE_COMMAND" "$@"
}

source_bun() {
  if [ -n "${BUN_BIN:-}" ]; then
    printf '%s\n' "$BUN_BIN"
  elif command -v bun >/dev/null 2>&1; then
    command -v bun
  fi
}

run_source() {
  SOURCE_DIR=${OPENCODE_SOURCE_DIR:-}
  if [ -z "$SOURCE_DIR" ]; then
    echo "OPENCODE_RUNTIME=source requires OPENCODE_SOURCE_DIR." >&2
    exit 1
  fi
  if [ ! -f "$SOURCE_DIR/packages/opencode/src/index.ts" ]; then
    echo "OpenCode source directory is unavailable: $SOURCE_DIR" >&2
    exit 1
  fi
  BUN_COMMAND=$(source_bun)
  if [ -z "$BUN_COMMAND" ]; then
    echo "OpenCode source mode requires Bun. Set BUN_BIN or install bun." >&2
    exit 1
  fi
  if [ ! -e "$SOURCE_DIR/node_modules/@opencode-ai/tui" ]; then
    echo "OpenCode source dependencies are missing. Run 'bun install' in $SOURCE_DIR." >&2
    exit 1
  fi
  cd "$SOURCE_DIR/packages/opencode"
  if [ "$OPENCODE_COMMAND" = "serve" ]; then
    exec "$BUN_COMMAND" run --conditions=browser ./src/index.ts serve \
      --hostname 127.0.0.1 \
      --port "$OPENCODE_PORT" \
      "$@"
  fi
  exec "$BUN_COMMAND" run --conditions=browser ./src/index.ts \
    "$OPENCODE_COMMAND" "$@"
}

run_package() {
  if ! command -v npx >/dev/null 2>&1; then
    echo "OpenCode package mode requires npx." >&2
    exit 1
  fi
  if [ "$OPENCODE_COMMAND" = "serve" ]; then
    exec npx --yes "$OPENCODE_PACKAGE" serve \
      --hostname 127.0.0.1 \
      --port "$OPENCODE_PORT" \
      "$@"
  fi
  exec npx --yes "$OPENCODE_PACKAGE" "$OPENCODE_COMMAND" "$@"
}

installed_version() {
  opencode --version 2>/dev/null | head -n 1
}

version_supported() {
  "$QWEN_AUDIO_AGENT_NODE" -e '
    const parse = value => {
      const match = String(value).match(/(\d+)\.(\d+)\.(\d+)/)
      return match ? match.slice(1).map(Number) : null
    }
    const actual = parse(process.argv[1])
    const minimum = parse(process.argv[2])
    if (!actual || !minimum) process.exit(1)
    for (let index = 0; index < 3; index += 1) {
      if (actual[index] > minimum[index]) process.exit(0)
      if (actual[index] < minimum[index]) process.exit(1)
    }
  ' "$1" "$OPENCODE_MIN_VERSION"
}

run_installed() {
  if ! command -v opencode >/dev/null 2>&1; then
    echo "OPENCODE_RUNTIME=installed requires opencode on PATH." >&2
    exit 1
  fi
  VERSION=$(installed_version)
  if ! version_supported "$VERSION"; then
    echo "Installed OpenCode $VERSION is older than the supported minimum $OPENCODE_MIN_VERSION." >&2
    exit 1
  fi
  if [ "$OPENCODE_COMMAND" = "serve" ]; then
    exec opencode serve --hostname 127.0.0.1 --port "$OPENCODE_PORT" "$@"
  fi
  exec opencode "$OPENCODE_COMMAND" "$@"
}

case "$OPENCODE_RUNTIME" in
  binary)
    if [ -z "${OPENCODE_BIN:-}" ]; then
      echo "OPENCODE_RUNTIME=binary requires OPENCODE_BIN." >&2
      exit 1
    fi
    run_binary "$@"
    ;;
  source)
    run_source "$@"
    ;;
  package)
    run_package "$@"
    ;;
  installed)
    run_installed "$@"
    ;;
  auto) ;;
  *)
    echo "Unknown OPENCODE_RUNTIME: $OPENCODE_RUNTIME" >&2
    exit 1
    ;;
esac

if [ -n "${OPENCODE_BIN:-}" ]; then
  run_binary "$@"
fi

if [ -n "${OPENCODE_SOURCE_DIR:-}" ]; then
  run_source "$@"
fi

if command -v opencode >/dev/null 2>&1; then
  VERSION=$(installed_version)
  if version_supported "$VERSION"; then
    if [ "$OPENCODE_COMMAND" = "serve" ]; then
      exec opencode serve --hostname 127.0.0.1 --port "$OPENCODE_PORT" "$@"
    fi
    exec opencode "$OPENCODE_COMMAND" "$@"
  fi
  echo "Installed OpenCode $VERSION is older than the supported minimum $OPENCODE_MIN_VERSION." >&2
  exit 1
fi

echo "OpenCode is not installed. Install OpenCode or set OPENCODE_BIN." >&2
exit 1
