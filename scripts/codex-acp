#!/bin/sh
set -eu

QWEN_AUDIO_AGENT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
CODEX_ACP_RUNTIME=${CODEX_ACP_RUNTIME:-auto}
CODEX_ACP_PACKAGE=${CODEX_ACP_PACKAGE:-@agentclientprotocol/codex-acp@1.1.7}

if [ "${QWEN_AUDIO_AGENT_ENV_LOADED:-}" != "1" ]; then
  if [ -f "$QWEN_AUDIO_AGENT_ROOT/.env.local" ]; then
    set -a
    . "$QWEN_AUDIO_AGENT_ROOT/.env.local"
    set +a
  elif [ -f "$QWEN_AUDIO_AGENT_ROOT/.env" ]; then
    set -a
    . "$QWEN_AUDIO_AGENT_ROOT/.env"
    set +a
  fi
  export QWEN_AUDIO_AGENT_ENV_LOADED=1
fi

export CODEX_API_KEY=${CODEX_API_KEY:-${DASHSCOPE_API_KEY:-}}
export NO_BROWSER=${NO_BROWSER:-1}

run_binary() {
  exec "$CODEX_ACP_BIN" "$@"
}

run_package() {
  if ! command -v npx >/dev/null 2>&1; then
    echo "codex-acp package mode requires npx." >&2
    exit 1
  fi
  exec npx -y "$CODEX_ACP_PACKAGE" "$@"
}

case "$CODEX_ACP_RUNTIME" in
  binary)
    CODEX_ACP_BIN=${CODEX_ACP_BIN:-codex-acp}
    run_binary "$@"
    ;;
  package)
    run_package "$@"
    ;;
  auto)
    if [ -n "${CODEX_ACP_BIN:-}" ]; then
      run_binary "$@"
    elif command -v codex-acp >/dev/null 2>&1; then
      CODEX_ACP_BIN=$(command -v codex-acp)
      run_binary "$@"
    else
      run_package "$@"
    fi
    ;;
  *)
    echo "Unsupported CODEX_ACP_RUNTIME: $CODEX_ACP_RUNTIME" >&2
    exit 1
    ;;
esac
