#!/bin/sh
set -eu

QWEN_AUDIO_AGENT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ "${QWEN_AUDIO_AGENT_ENV_LOADED:-}" != "1" ]; then
  if [ -f "$QWEN_AUDIO_AGENT_ROOT/.env.local" ]; then
    set -a
    . "$QWEN_AUDIO_AGENT_ROOT/.env.local"
    set +a
  elif [ -f "$QWEN_AUDIO_AGENT_ROOT/.env" ]; then
    set -a
    . "$QWEN_AUDIO_AGENT_ROOT/.env"
    set +a
  fi
  export QWEN_AUDIO_AGENT_ENV_LOADED=1
fi

BACKEND=${AGENT_PROTOCOL:-opencode}

case "$BACKEND" in
  opencode)
    printf '%s\n' 'Starting qwen-audio-agent backend: OpenCode'
    exec "$QWEN_AUDIO_AGENT_ROOT/scripts/opencode-server" "$@"
    ;;
  openclaw)
    printf '%s\n' 'Starting qwen-audio-agent backend: OpenClaw'
    exec "$QWEN_AUDIO_AGENT_ROOT/scripts/openclaw-gateway" "$@"
    ;;
  *)
    echo "Unsupported AGENT_PROTOCOL: $BACKEND (expected opencode or openclaw)" >&2
    exit 1
    ;;
esac
