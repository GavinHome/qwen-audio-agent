#!/bin/sh
set -eu

QWEN_AUDIO_AGENT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export QWEN_AUDIO_AGENT_ROOT

if [ "${QWEN_AUDIO_AGENT_ENV_LOADED:-}" != "1" ]; then
  if [ -f "$QWEN_AUDIO_AGENT_ROOT/.env.local" ]; then
    set -a
    . "$QWEN_AUDIO_AGENT_ROOT/.env.local"
    set +a
  elif [ -f "$QWEN_AUDIO_AGENT_ROOT/.env" ]; then
    set -a
    . "$QWEN_AUDIO_AGENT_ROOT/.env"
    set +a
  fi
  export QWEN_AUDIO_AGENT_ENV_LOADED=1
fi

if [ -n "${QWAUDIO_CONFIG_DIR:-}" ]; then
  QWEN_AUDIO_AGENT_USER_DIR=$QWAUDIO_CONFIG_DIR
elif [ -n "${XDG_CONFIG_HOME:-}" ]; then
  QWEN_AUDIO_AGENT_USER_DIR="$XDG_CONFIG_HOME/qwaudio"
elif [ -n "${HOME:-}" ]; then
  QWEN_AUDIO_AGENT_USER_DIR="$HOME/.config/qwaudio"
else
  echo "OpenClaw requires QWAUDIO_CONFIG_DIR, XDG_CONFIG_HOME, or HOME." >&2
  exit 1
fi
export QWEN_AUDIO_AGENT_OPENCLAW_STATE_DIR=${QWEN_AUDIO_AGENT_OPENCLAW_STATE_DIR:-"$QWEN_AUDIO_AGENT_USER_DIR/backends/openclaw/state"}
export QWEN_AUDIO_AGENT_OPENCLAW_WORKSPACE=${QWEN_AUDIO_AGENT_OPENCLAW_WORKSPACE:-"$QWEN_AUDIO_AGENT_USER_DIR/workspaces/openclaw"}
mkdir -p "$QWEN_AUDIO_AGENT_OPENCLAW_STATE_DIR" "$QWEN_AUDIO_AGENT_OPENCLAW_WORKSPACE"
if [ ! -f "$QWEN_AUDIO_AGENT_OPENCLAW_WORKSPACE/AGENTS.md" ]; then
  cp "$QWEN_AUDIO_AGENT_ROOT/config/openclaw/workspace/AGENTS.md" "$QWEN_AUDIO_AGENT_OPENCLAW_WORKSPACE/AGENTS.md"
fi

COMMON_BACKEND_MODEL=${QWEN_AUDIO_AGENT_BACKEND_MODEL:-}
NORMALIZED_BACKEND_MODEL=$(printf '%s' "$COMMON_BACKEND_MODEL" | tr '[:upper:]' '[:lower:]')
QWEN_AUDIO_AGENT_MANAGED_OPENCLAW=0
if [ -z "${OPENCLAW_CONFIG_PATH:-}" ] \
  && [ -n "${DASHSCOPE_API_KEY:-}" ] \
  && [ -n "$COMMON_BACKEND_MODEL" ] \
  && [ "$NORMALIZED_BACKEND_MODEL" != "auto" ]; then
  QWEN_AUDIO_AGENT_MANAGED_OPENCLAW=1
  QWEN_AUDIO_AGENT_OPENCLAW_CONFIG_DIR="$QWEN_AUDIO_AGENT_USER_DIR/backends/openclaw"
  mkdir -p "$QWEN_AUDIO_AGENT_OPENCLAW_CONFIG_DIR"
  cp "$QWEN_AUDIO_AGENT_ROOT/config/openclaw/openclaw.json5" \
    "$QWEN_AUDIO_AGENT_OPENCLAW_CONFIG_DIR/openclaw.json5"
  export OPENCLAW_CONFIG_PATH="$QWEN_AUDIO_AGENT_OPENCLAW_CONFIG_DIR/openclaw.json5"
  QWEN_AUDIO_AGENT_OPENCLAW_MODEL="bailian/${COMMON_BACKEND_MODEL#*/}"
  QWEN_AUDIO_AGENT_OPENCLAW_MODEL_ID=${COMMON_BACKEND_MODEL#*/}
  export QWEN_AUDIO_AGENT_OPENCLAW_MODEL
  export QWEN_AUDIO_AGENT_OPENCLAW_MODEL_ID
fi

if [ "${1:-}" = "gateway" ]; then
  if [ "$QWEN_AUDIO_AGENT_MANAGED_OPENCLAW" != "1" ] \
    && [ -z "${OPENCLAW_CONFIG_PATH:-}" ] \
    && [ -n "${HOME:-}" ] \
    && [ -f "$HOME/.openclaw/openclaw.json" ]; then
    export OPENCLAW_CONFIG_PATH="$HOME/.openclaw/openclaw.json"
  fi
  OPENCLAW_RUNTIME_STATE_DIR="$QWEN_AUDIO_AGENT_OPENCLAW_STATE_DIR/gateway-${OPENCLAW_PORT:-18789}"
  mkdir -p "$OPENCLAW_RUNTIME_STATE_DIR"
  export OPENCLAW_STATE_DIR="$OPENCLAW_RUNTIME_STATE_DIR"

  # Reuse user-installed OpenClaw capabilities without sharing mutable
  # Gateway/Session state or external message channels with another instance.
  if [ "$QWEN_AUDIO_AGENT_MANAGED_OPENCLAW" != "1" ] \
    && [ -n "${OPENCLAW_CONFIG_PATH:-}" ]; then
    OPENCLAW_USER_CONFIG_PATH=$OPENCLAW_CONFIG_PATH
    OPENCLAW_USER_STATE_DIR=$(dirname -- "$OPENCLAW_USER_CONFIG_PATH")
    OPENCLAW_RUNTIME_CONFIG_PATH="$OPENCLAW_RUNTIME_STATE_DIR/openclaw.json"
    "${QWEN_AUDIO_AGENT_NODE:-node}" \
      "$QWEN_AUDIO_AGENT_ROOT/scripts/prepare-openclaw-config.mjs" \
      "$OPENCLAW_USER_CONFIG_PATH" \
      "$OPENCLAW_RUNTIME_CONFIG_PATH"
    export OPENCLAW_CONFIG_PATH="$OPENCLAW_RUNTIME_CONFIG_PATH"
    for SHARED_CAPABILITY_DIR in extensions skills plugin-skills service-env; do
      if [ -d "$OPENCLAW_USER_STATE_DIR/$SHARED_CAPABILITY_DIR" ] \
        && [ ! -e "$OPENCLAW_RUNTIME_STATE_DIR/$SHARED_CAPABILITY_DIR" ]; then
        ln -s "$OPENCLAW_USER_STATE_DIR/$SHARED_CAPABILITY_DIR" \
          "$OPENCLAW_RUNTIME_STATE_DIR/$SHARED_CAPABILITY_DIR"
      fi
    done
  fi
fi

if [ -z "${OPENCLAW_GATEWAY_TOKEN:-}" ]; then
  if [ -n "${AGENT_API_KEY:-}" ]; then
    OPENCLAW_GATEWAY_TOKEN=$AGENT_API_KEY
  elif [ "$QWEN_AUDIO_AGENT_MANAGED_OPENCLAW" = "1" ]; then
    OPENCLAW_GATEWAY_TOKEN=${QWEN_AUDIO_AGENT_AUTH_SECRET:-}
  else
    OPENCLAW_GATEWAY_TOKEN=
  fi
fi
export OPENCLAW_GATEWAY_TOKEN
OPENCLAW_GATEWAY_TOKEN_FILE=${OPENCLAW_GATEWAY_TOKEN_FILE:-"$QWEN_AUDIO_AGENT_OPENCLAW_STATE_DIR/gateway-token"}
if [ -n "$OPENCLAW_GATEWAY_TOKEN" ]; then
  OPENCLAW_GATEWAY_TOKEN_TMP="$OPENCLAW_GATEWAY_TOKEN_FILE.tmp.$$"
  umask 077
  printf '%s\n' "$OPENCLAW_GATEWAY_TOKEN" > "$OPENCLAW_GATEWAY_TOKEN_TMP"
  chmod 600 "$OPENCLAW_GATEWAY_TOKEN_TMP"
  mv -f "$OPENCLAW_GATEWAY_TOKEN_TMP" "$OPENCLAW_GATEWAY_TOKEN_FILE"
elif [ "${1:-}" = "gateway" ]; then
  "${QWEN_AUDIO_AGENT_NODE:-node}" \
    "$QWEN_AUDIO_AGENT_ROOT/scripts/sync-openclaw-gateway-token.mjs" \
    "$OPENCLAW_GATEWAY_TOKEN_FILE"
fi
export OPENCLAW_GATEWAY_TOKEN_FILE
OPENCLAW_RUNTIME=${OPENCLAW_RUNTIME:-auto}
OPENCLAW_PACKAGE=${OPENCLAW_PACKAGE:-openclaw@2026.6.33}
OPENCLAW_BUNDLE_BIN=${OPENCLAW_BUNDLE_BIN-${HOME:+$HOME/.openclaw-bundle/wrapper/openclaw}}

run_binary() {
  exec "$OPENCLAW_BIN" "$@"
}

run_installed() {
  exec openclaw "$@"
}

run_bundle() {
  exec "$OPENCLAW_BUNDLE_BIN" "$@"
}

bundle_available() {
  [ -n "$OPENCLAW_BUNDLE_BIN" ] && [ -x "$OPENCLAW_BUNDLE_BIN" ]
}

run_source() {
  SOURCE_DIR=${OPENCLAW_SOURCE_DIR:-}
  if [ -z "$SOURCE_DIR" ]; then
    echo "OPENCLAW_RUNTIME=source requires OPENCLAW_SOURCE_DIR." >&2
    exit 1
  fi
  if [ ! -f "$SOURCE_DIR/package.json" ]; then
    echo "OpenClaw source directory is unavailable: $SOURCE_DIR" >&2
    exit 1
  fi
  if ! command -v corepack >/dev/null 2>&1; then
    echo "OpenClaw source mode requires corepack." >&2
    exit 1
  fi
  cd "$SOURCE_DIR"
  exec corepack pnpm openclaw "$@"
}

run_package() {
  if ! command -v npx >/dev/null 2>&1; then
    echo "OpenClaw package mode requires npx." >&2
    exit 1
  fi
  OPENCLAW_PACKAGE_BIN=$(
    npx --yes --package "$OPENCLAW_PACKAGE" -- which openclaw
  )
  if [ -z "$OPENCLAW_PACKAGE_BIN" ] || [ ! -x "$OPENCLAW_PACKAGE_BIN" ]; then
    echo "Unable to resolve OpenClaw package binary: $OPENCLAW_PACKAGE" >&2
    exit 1
  fi
  # npx normally remains as a parent process for the complete OpenClaw
  # lifetime. Resolve the pinned package once, then exec its binary directly
  # to avoid retaining an extra Node/npm process for both Gateway and ACP.
  exec "$OPENCLAW_PACKAGE_BIN" "$@"
}

run_managed_package() {
  if [ -z "${DASHSCOPE_API_KEY:-}" ]; then
    echo "Automatic OpenClaw setup requires DASHSCOPE_API_KEY." >&2
    exit 1
  fi
  if [ -z "$COMMON_BACKEND_MODEL" ] \
    || [ "$NORMALIZED_BACKEND_MODEL" = "auto" ]; then
    echo "Automatic OpenClaw setup requires QWEN_AUDIO_AGENT_BACKEND_MODEL." >&2
    exit 1
  fi
  run_package "$@"
}

case "$OPENCLAW_RUNTIME" in
  binary)
    if [ -z "${OPENCLAW_BIN:-}" ]; then
      echo "OPENCLAW_RUNTIME=binary requires OPENCLAW_BIN." >&2
      exit 1
    fi
    run_binary "$@"
    ;;
  installed)
    if ! command -v openclaw >/dev/null 2>&1; then
      echo "OPENCLAW_RUNTIME=installed requires openclaw on PATH." >&2
      exit 1
    fi
    run_installed "$@"
    ;;
  bundle)
    if ! bundle_available; then
      echo "OPENCLAW_RUNTIME=bundle requires the enterprise OpenClaw bundle or OPENCLAW_BUNDLE_BIN." >&2
      exit 1
    fi
    run_bundle "$@"
    ;;
  source)
    run_source "$@"
    ;;
  package)
    run_package "$@"
    ;;
  auto) ;;
  *)
    echo "Unknown OPENCLAW_RUNTIME: $OPENCLAW_RUNTIME" >&2
    exit 1
    ;;
esac

if [ -n "${OPENCLAW_BIN:-}" ]; then
  run_binary "$@"
fi

if [ -n "${OPENCLAW_SOURCE_DIR:-}" ]; then
  run_source "$@"
fi

# OpenClaw Enterprise installs its policy-enforcing wrapper outside the normal
# npm PATH. Prefer that explicit installation over unrelated global packages
# and over downloading the public package at runtime.
if bundle_available; then
  run_bundle "$@"
fi

if command -v openclaw >/dev/null 2>&1; then
  run_installed "$@"
fi

run_managed_package "$@"
