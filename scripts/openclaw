#!/bin/sh
set -eu

QWEN_AUDIO_AGENT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export QWEN_AUDIO_AGENT_ROOT

if [ "${QWEN_AUDIO_AGENT_ENV_LOADED:-}" != "1" ]; then
  if [ -f "$QWEN_AUDIO_AGENT_ROOT/.env.local" ]; then
    set -a
    . "$QWEN_AUDIO_AGENT_ROOT/.env.local"
    set +a
  elif [ -f "$QWEN_AUDIO_AGENT_ROOT/.env" ]; then
    set -a
    . "$QWEN_AUDIO_AGENT_ROOT/.env"
    set +a
  fi
  export QWEN_AUDIO_AGENT_ENV_LOADED=1
fi

if [ -n "${QWAUDIO_CONFIG_DIR:-}" ]; then
  QWEN_AUDIO_AGENT_USER_DIR=$QWAUDIO_CONFIG_DIR
elif [ -n "${XDG_CONFIG_HOME:-}" ]; then
  QWEN_AUDIO_AGENT_USER_DIR="$XDG_CONFIG_HOME/qwaudio"
elif [ -n "${HOME:-}" ]; then
  QWEN_AUDIO_AGENT_USER_DIR="$HOME/.config/qwaudio"
else
  echo "OpenClaw requires QWAUDIO_CONFIG_DIR, XDG_CONFIG_HOME, or HOME." >&2
  exit 1
fi
export OPENCLAW_STATE_DIR=${OPENCLAW_STATE_DIR:-"$QWEN_AUDIO_AGENT_USER_DIR/backends/openclaw/state"}
export QWEN_AUDIO_AGENT_OPENCLAW_WORKSPACE=${QWEN_AUDIO_AGENT_OPENCLAW_WORKSPACE:-"$QWEN_AUDIO_AGENT_USER_DIR/workspaces/openclaw"}
mkdir -p "$OPENCLAW_STATE_DIR" "$QWEN_AUDIO_AGENT_OPENCLAW_WORKSPACE"
if [ ! -f "$QWEN_AUDIO_AGENT_OPENCLAW_WORKSPACE/AGENTS.md" ]; then
  cp "$QWEN_AUDIO_AGENT_ROOT/config/openclaw/workspace/AGENTS.md" "$QWEN_AUDIO_AGENT_OPENCLAW_WORKSPACE/AGENTS.md"
fi
if [ -z "${OPENCLAW_CONFIG_PATH:-}" ]; then
  QWEN_AUDIO_AGENT_OPENCLAW_CONFIG_DIR="$QWEN_AUDIO_AGENT_USER_DIR/backends/openclaw"
  mkdir -p "$QWEN_AUDIO_AGENT_OPENCLAW_CONFIG_DIR"
  cp "$QWEN_AUDIO_AGENT_ROOT/config/openclaw/openclaw.json5" "$QWEN_AUDIO_AGENT_OPENCLAW_CONFIG_DIR/openclaw.json5"
  export OPENCLAW_CONFIG_PATH="$QWEN_AUDIO_AGENT_OPENCLAW_CONFIG_DIR/openclaw.json5"
fi

export OPENCLAW_GATEWAY_TOKEN=${OPENCLAW_GATEWAY_TOKEN:-${AGENT_API_KEY:-${QWEN_AUDIO_AGENT_AUTH_SECRET:-}}}
OPENCLAW_GATEWAY_TOKEN_FILE=${OPENCLAW_GATEWAY_TOKEN_FILE:-"$OPENCLAW_STATE_DIR/gateway-token"}
if [ -n "$OPENCLAW_GATEWAY_TOKEN" ]; then
  OPENCLAW_GATEWAY_TOKEN_TMP="$OPENCLAW_GATEWAY_TOKEN_FILE.tmp.$$"
  umask 077
  printf '%s\n' "$OPENCLAW_GATEWAY_TOKEN" > "$OPENCLAW_GATEWAY_TOKEN_TMP"
  chmod 600 "$OPENCLAW_GATEWAY_TOKEN_TMP"
  mv -f "$OPENCLAW_GATEWAY_TOKEN_TMP" "$OPENCLAW_GATEWAY_TOKEN_FILE"
fi
export OPENCLAW_GATEWAY_TOKEN_FILE
OPENCLAW_RUNTIME=${OPENCLAW_RUNTIME:-auto}
OPENCLAW_PACKAGE=${OPENCLAW_PACKAGE:-openclaw@2026.6.33}
OPENCLAW_BUNDLE_BIN=${OPENCLAW_BUNDLE_BIN-${HOME:+$HOME/.openclaw-bundle/wrapper/openclaw}}
COMMON_BACKEND_MODEL=${QWEN_AUDIO_AGENT_BACKEND_MODEL:-qwen3.7-max}

if [ -n "${OPENCLAW_MODEL:-}" ]; then
  BACKEND_MODEL=$OPENCLAW_MODEL
else
  BACKEND_MODEL="bailian/${COMMON_BACKEND_MODEL#*/}"
fi

case "$BACKEND_MODEL" in
  */*)
    QWEN_AUDIO_AGENT_OPENCLAW_MODEL="$BACKEND_MODEL"
    QWEN_AUDIO_AGENT_OPENCLAW_MODEL_ID=${BACKEND_MODEL#*/}
    ;;
  *)
    QWEN_AUDIO_AGENT_OPENCLAW_MODEL="bailian/$BACKEND_MODEL"
    QWEN_AUDIO_AGENT_OPENCLAW_MODEL_ID="$BACKEND_MODEL"
    ;;
esac
export QWEN_AUDIO_AGENT_OPENCLAW_MODEL
export QWEN_AUDIO_AGENT_OPENCLAW_MODEL_ID

run_binary() {
  exec "$OPENCLAW_BIN" "$@"
}

run_installed() {
  exec openclaw "$@"
}

run_bundle() {
  exec "$OPENCLAW_BUNDLE_BIN" "$@"
}

bundle_available() {
  [ -n "$OPENCLAW_BUNDLE_BIN" ] && [ -x "$OPENCLAW_BUNDLE_BIN" ]
}

installed_matches_package() {
  OPENCLAW_EXPECTED_VERSION=${OPENCLAW_PACKAGE##*@}
  OPENCLAW_INSTALLED_VERSION=$(
    openclaw --version 2>/dev/null || true
  )
  case "$OPENCLAW_INSTALLED_VERSION" in
    *"$OPENCLAW_EXPECTED_VERSION"*) return 0 ;;
    *) return 1 ;;
  esac
}

run_source() {
  SOURCE_DIR=${OPENCLAW_SOURCE_DIR:-}
  if [ -z "$SOURCE_DIR" ]; then
    echo "OPENCLAW_RUNTIME=source requires OPENCLAW_SOURCE_DIR." >&2
    exit 1
  fi
  if [ ! -f "$SOURCE_DIR/package.json" ]; then
    echo "OpenClaw source directory is unavailable: $SOURCE_DIR" >&2
    exit 1
  fi
  if ! command -v corepack >/dev/null 2>&1; then
    echo "OpenClaw source mode requires corepack." >&2
    exit 1
  fi
  cd "$SOURCE_DIR"
  exec corepack pnpm openclaw "$@"
}

run_package() {
  if ! command -v npx >/dev/null 2>&1; then
    echo "OpenClaw package mode requires npx." >&2
    exit 1
  fi
  OPENCLAW_PACKAGE_BIN=$(
    npx --yes --package "$OPENCLAW_PACKAGE" -- which openclaw
  )
  if [ -z "$OPENCLAW_PACKAGE_BIN" ] || [ ! -x "$OPENCLAW_PACKAGE_BIN" ]; then
    echo "Unable to resolve OpenClaw package binary: $OPENCLAW_PACKAGE" >&2
    exit 1
  fi
  # npx normally remains as a parent process for the complete OpenClaw
  # lifetime. Resolve the pinned package once, then exec its binary directly
  # to avoid retaining an extra Node/npm process for both Gateway and ACP.
  exec "$OPENCLAW_PACKAGE_BIN" "$@"
}

case "$OPENCLAW_RUNTIME" in
  binary)
    if [ -z "${OPENCLAW_BIN:-}" ]; then
      echo "OPENCLAW_RUNTIME=binary requires OPENCLAW_BIN." >&2
      exit 1
    fi
    run_binary "$@"
    ;;
  installed)
    if ! command -v openclaw >/dev/null 2>&1; then
      echo "OPENCLAW_RUNTIME=installed requires openclaw on PATH." >&2
      exit 1
    fi
    run_installed "$@"
    ;;
  bundle)
    if ! bundle_available; then
      echo "OPENCLAW_RUNTIME=bundle requires the enterprise OpenClaw bundle or OPENCLAW_BUNDLE_BIN." >&2
      exit 1
    fi
    run_bundle "$@"
    ;;
  source)
    run_source "$@"
    ;;
  package)
    run_package "$@"
    ;;
  auto) ;;
  *)
    echo "Unknown OPENCLAW_RUNTIME: $OPENCLAW_RUNTIME" >&2
    exit 1
    ;;
esac

if [ -n "${OPENCLAW_BIN:-}" ]; then
  run_binary "$@"
fi

if [ -n "${OPENCLAW_SOURCE_DIR:-}" ]; then
  run_source "$@"
fi

# OpenClaw Enterprise installs its policy-enforcing wrapper outside the normal
# npm PATH. Prefer that explicit installation over unrelated global packages
# and over downloading the public package at runtime.
if bundle_available; then
  run_bundle "$@"
fi

if command -v openclaw >/dev/null 2>&1 && installed_matches_package; then
  run_installed "$@"
fi

run_package "$@"
