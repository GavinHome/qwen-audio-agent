#!/bin/sh
set -eu

QWEN_AUDIO_AGENT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
CLAUDE_CODE_ACP_RUNTIME=${CLAUDE_CODE_ACP_RUNTIME:-auto}
CLAUDE_CODE_ACP_PACKAGE=${CLAUDE_CODE_ACP_PACKAGE:-@zed-industries/claude-code-acp@0.16.2}

if [ "${QWEN_AUDIO_AGENT_ENV_LOADED:-}" != "1" ]; then
  if [ -f "$QWEN_AUDIO_AGENT_ROOT/.env.local" ]; then
    set -a
    . "$QWEN_AUDIO_AGENT_ROOT/.env.local"
    set +a
  elif [ -f "$QWEN_AUDIO_AGENT_ROOT/.env" ]; then
    set -a
    . "$QWEN_AUDIO_AGENT_ROOT/.env"
    set +a
  fi
  export QWEN_AUDIO_AGENT_ENV_LOADED=1
fi

if [ -z "${ANTHROPIC_API_KEY:-}" ] && [ -n "${CLAUDE_API_KEY:-}" ]; then
  export ANTHROPIC_API_KEY="$CLAUDE_API_KEY"
fi

if [ -z "${CLAUDE_CODE_EXECUTABLE:-}" ]; then
  if command -v claude >/dev/null 2>&1; then
    CLAUDE_CODE_EXECUTABLE=$(command -v claude)
    export CLAUDE_CODE_EXECUTABLE
  else
    echo "Claude Code is not installed. Install Claude Code or set CLAUDE_CODE_EXECUTABLE." >&2
    exit 1
  fi
fi

run_binary() {
  exec "$CLAUDE_CODE_ACP_BIN" "$@"
}

run_package() {
  if [ "${QWEN_AUDIO_AGENT_DESKTOP_INSTALLED_ONLY:-}" = "1" ]; then
    echo "claude-code-acp is not installed. Install the ACP adapter before selecting Claude Code in the desktop app." >&2
    exit 1
  fi
  if ! command -v npx >/dev/null 2>&1; then
    echo "claude-code-acp package mode requires npx." >&2
    exit 1
  fi
  exec npx -y "$CLAUDE_CODE_ACP_PACKAGE" "$@"
}

case "$CLAUDE_CODE_ACP_RUNTIME" in
  binary)
    CLAUDE_CODE_ACP_BIN=${CLAUDE_CODE_ACP_BIN:-claude-code-acp}
    run_binary "$@"
    ;;
  package)
    run_package "$@"
    ;;
  auto)
    if [ -n "${CLAUDE_CODE_ACP_BIN:-}" ]; then
      run_binary "$@"
    elif command -v claude-code-acp >/dev/null 2>&1; then
      CLAUDE_CODE_ACP_BIN=$(command -v claude-code-acp)
      run_binary "$@"
    else
      run_package "$@"
    fi
    ;;
  *)
    echo "Unsupported CLAUDE_CODE_ACP_RUNTIME: $CLAUDE_CODE_ACP_RUNTIME" >&2
    exit 1
    ;;
esac
